# Copy to .env.local. The value is the CONVEX_URL that `npx convex dev`
# writes to backend/.env.local (https://<deployment-name>.convex.cloud).
NEXT_PUBLIC_CONVEX_URL=

# Optional. Where the /join QR code points. Defaults to the site it is shown
# on, which a phone can't open if that is localhost. Use the deployed URL or
# your laptop's LAN address (e.g. http://192.168.1.20:3000).
NEXT_PUBLIC_SITE_URL=
